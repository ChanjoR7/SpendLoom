# Copy this file to backend/.env and fill in your own values.
# Never commit the real .env file.

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/spendloom?retryWrites=true&w=majority

# Port the backend (and dashboard) runs on
PORT=3000

# Google AI Studio key for the AI money coach
GEMINI_API_KEY=your-gemini-api-key

# Optional: override the Gemini model
# GEMINI_MODEL=gemini-3.8-flash

# Optional limits
# AI_RATE_LIMIT=15        # AI questions per minute per account
# AUTH_RATE_LIMIT=30      # sign up / log in attempts per 15 min per IP
